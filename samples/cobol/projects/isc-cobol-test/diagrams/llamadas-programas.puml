@startuml
!theme plain
skinparam backgroundColor #FEFEFE
skinparam defaultFontName Courier
skinparam component {
  BackgroundColor #F5F5F5
  BorderColor #333333
  FontName Courier
}

title "Diagrama de Llamadas (CALL Graph) - Sistema Bancario COBOL"

'--- Common Services ---
package "Common Services" as COMMON {
  [COMMENU] as COMMENU
  [COMDATE] as COMDATE
  [COMHELP] as COMHELP
  [COMSCRN] as COMSCRN
}

'--- Security ---
package "Security" as SEC {
  [BNK0001] as BNK0001
  [SECSGN00] as SECSGN00
  [SECSGO00] as SECSGO00
  [SECMNU00] as SECMNU00
  [SECUSR00] as SECUSR00
  [SECPWD00] as SECPWD00
  [SECAUD00] as SECAUD00
}

'--- Customer Module ---
package "Customer" as CUS {
  [CUSMNU00] as CUSMNU
  [CUSSRH00] as CUSSRH
  [CUSINQ00] as CUSINQ
  [CUSMNT00] as CUSMNT
  [CUSUPD00] as CUSUPD
  [CUSADR00] as CUSADR
  [CUSREL00] as CUSREL
  [CUSSTS00] as CUSSTS
}

'--- Account Module ---
package "Account" as ACT {
  [ACTMNU00] as ACTMNU
  [ACTINQ00] as ACTINQ
  [ACTOPN00] as ACTOPN
  [ACTUPD00] as ACTUPD
  [ACTCLS00] as ACTCLS
  [ACTFRZ00] as ACTFRZ
  [ACTBAL00] as ACTBAL
  [ACTSTM00] as ACTSTM
}

'--- Teller Module ---
package "Teller" as TLR {
  [TLRMNU00] as TLRMNU
  [TLRSGN00] as TLRSGN
  [TLRDEP00] as TLRDEP
  [TLRWTH00] as TLRWTH
  [TLRTRF00] as TLRTRF
  [TLRPYM00] as TLRPYM
  [TLRCHE00] as TLRCHE
  [TLRSMG00] as TLRSMG
}

'--- Loans Module ---
package "Loans" as LON {
  [LONMNU00] as LONMNU
  [LONINQ00] as LONINQ
  [LONAPL00] as LONAPL
  [LONAPV00] as LONAPV
  [LONDIS00] as LONDIS
  [LONPYM00] as LONPYM
  [LONAMR00] as LONAMR
  [LONDEL00] as LONDEL
}

'--- Deposits Module ---
package "Deposits" as DEP {
  [DEPMNU00] as DEPMNU
  [DEPINQ00] as DEPINQ
  [DEPOPN00] as DEPOPN
  [DEPINT00] as DEPINT
  [DEPWTH00] as DEPWTH
  [DEPSTM00] as DEPSTM
  [DEPREN00] as DEPREN
}

'--- TimeDep Module ---
package "TimeDep" as TD {
  [TDMNU000] as TDMNU
  [TDOPN000] as TDOPN
  [TDINQ000] as TDINQ
  [TDCLS000] as TDCLS
  [TDINT000] as TDINT
}

'--- Transfers Module ---
package "Transfers" as FTR {
  [FTMNU000] as FTMNU
  [FTINT000] as FTINT
  [FTWIR000] as FTWIR
  [FTACH000] as FTACH
  [FTSTS000] as FTSTS
}

'--- Batch Module ---
package "Batch" as BCH {
  [BCHMNU00] as BCHMNU
  [BCHDAY00] as BCHDAY
  [BCHMTH00] as BCHMTH
  [BCHINT00] as BCHINT
  [BCHGLI00] as BCHGLI
  [BCHODO00] as BCHODO
  [BCHFEE00] as BCHFEE
}

'--- Reports Module ---
package "Reports" as RPT {
  [RPTMNU00] as RPTMNU
  [RPTBAL00] as RPTBAL
  [RPTTXN00] as RPTTXN
  [RPTDEL00] as RPTDEL
  [RPTTLR00] as RPTTLR
  [RPTGLB00] as RPTGLB
  [RPTREG00] as RPTREG
}

'--- Audit Module ---
package "Audit" as AUD {
  [AUDTRL00] as AUDTRL
  [AUDINQ00] as AUDINQ
}

'--- Files ---
package "Files (Indexed)" as FILES {
  () "CUSTOMER" as FCUS
  () "ACCOUNT" as FACT
  () "TRANLOG" as FTRN
  () "CARD" as FCRD
  () "LOANMAST" as FLON
  () "LOANAPPL" as FLAP
  () "USERPROF" as FUSR
  () "SECURITY" as FSEC
  () "DEPMAST" as FDEP
  () "TIMEDEP" as FTD
  () "GLMASTER" as FGL
  () "AUDITLOG" as FAUD
  () "BATCHCTL" as FBCH
  () "RATEFILE" as FRAT
  () "FEESCHED" as FFEE
  () "CHQBOOK" as FCHQ
  () "ACCTXREF" as FAXR
  () "TELLEREC" as FTLR
}

'--- CALL Flows ---

'COMMENU -> menus
COMMENU --> SECSGN00 : CALL
COMMENU --> CUSMNU : CALL
COMMENU --> ACTMNU : CALL
COMMENU --> TLRMNU : CALL
COMMENU --> LONMNU : CALL
COMMENU --> DEPMNU : CALL
COMMENU --> TDMNU : CALL
COMMENU --> FTMNU : CALL
COMMENU --> BCHMNU : CALL
COMMENU --> RPTMNU : CALL
COMMENU --> SECMNU : CALL
COMMENU --> COMDATE : CALL
COMMENU --> COMHELP : CALL
COMMENU --> COMSCRN : CALL

'Security -> common, audit
SECSGN00 --> COMDATE : CALL
SECSGN00 --> COMHELP : CALL
SECUSR00 --> AUDTRL : CALL
SECPWD00 --> AUDTRL : CALL
SECPWD00 --> COMDATE : CALL
SECAUD00 --> COMDATE : CALL
SECMNU00 --> SECUSR : CALL
SECMNU00 --> SECPWD : CALL
SECMNU00 --> SECAUD : CALL

'Customer -> common, audit, cross-module
CUSMNU --> CUSSRH : CALL
CUSMNU --> CUSINQ : CALL
CUSMNU --> CUSMNT : CALL
CUSMNU --> CUSUPD : CALL
CUSMNU --> CUSADR : CALL
CUSMNU --> CUSREL : CALL
CUSMNU --> CUSSTS : CALL
CUSMNU --> COMHELP : CALL
CUSMNU --> COMDATE : CALL
CUSMNT --> AUDTRL : CALL
CUSMNT --> COMDATE : CALL
CUSINQ --> ACTINQ : CALL (optional)
CUSINQ --> AUDTRL : CALL
CUSSRH --> AUDTRL : CALL

'Account -> common, audit, cross-module
ACTMNU --> ACTINQ : CALL
ACTMNU --> ACTOPN : CALL
ACTMNU --> ACTUPD : CALL
ACTMNU --> ACTCLS : CALL
ACTMNU --> ACTFRZ : CALL
ACTMNU --> ACTBAL : CALL
ACTMNU --> ACTSTM : CALL
ACTMNU --> COMHELP : CALL
ACTOPN --> CUSSRH : CALL
ACTOPN --> AUDTRL : CALL
ACTOPN --> COMDATE : CALL
ACTUPD --> AUDTRL : CALL
ACTCLS --> ACTBAL : CALL
ACTCLS --> AUDTRL : CALL
ACTBAL --> BCHODO : CALL (optional)
ACTSTM --> COMDATE : CALL

'Teller -> account, common, audit
TLRMNU --> TLRSGN : CALL
TLRMNU --> TLRDEP : CALL
TLRMNU --> TLRWTH : CALL
TLRMNU --> TLRTRF : CALL
TLRMNU --> TLRPYM : CALL
TLRMNU --> TLRCHE : CALL
TLRMNU --> TLRSMG : CALL
TLRSGN --> AUDTRL : CALL
TLRDEP --> ACTINQ : CALL
TLRDEP --> AUDTRL : CALL
TLRDEP --> COMDATE : CALL
TLRWTH --> ACTBAL : CALL
TLRWTH --> AUDTRL : CALL
TLRWTH --> BCHODO : CALL (optional)
TLRTRF --> ACTINQ : CALL
TLRTRF --> AUDTRL : CALL
TLRSMG --> COMDATE : CALL
TLRSMG --> RPTTLR : CALL

'Loans -> customer, teller, common, audit
LONMNU --> LONINQ : CALL
LONMNU --> LONAPL : CALL
LONMNU --> LONAPV : CALL
LONMNU --> LONDIS : CALL
LONMNU --> LONPYM : CALL
LONMNU --> LONAMR : CALL
LONMNU --> LONDEL : CALL
LONAPL --> CUSSRH : CALL
LONAPL --> AUDTRL : CALL
LONAPL --> COMDATE : CALL
LONAPV --> AUDTRL : CALL
LONDIS --> TLRTRF : CALL
LONDIS --> AUDTRL : CALL
LONDIS --> COMDATE : CALL
LONPYM --> LONAMR : CALL
LONPYM --> AUDTRL : CALL
LONPYM --> COMDATE : CALL
LONAMR --> COMDATE : CALL
LONDEL --> AUDTRL : CALL

'Deposits -> customer, common, audit
DEPMNU --> DEPINQ : CALL
DEPMNU --> DEPOPN : CALL
DEPMNU --> DEPINT : CALL
DEPMNU --> DEPWTH : CALL
DEPMNU --> DEPSTM : CALL
DEPMNU --> DEPREN : CALL
DEPOPN --> CUSSRH : CALL
DEPOPN --> AUDTRL : CALL
DEPOPN --> COMDATE : CALL
DEPINT --> AUDTRL : CALL
DEPREN --> AUDTRL : CALL
DEPSTM --> COMDATE : CALL

'TimeDep -> customer, account, common, audit
TDMNU --> TDOPN : CALL
TDMNU --> TDINQ : CALL
TDMNU --> TDCLS : CALL
TDMNU --> TDINT : CALL
TDOPN --> CUSSRH : CALL
TDOPN --> AUDTRL : CALL
TDOPN --> COMDATE : CALL
TDCLS --> ACTBAL : CALL
TDCLS --> AUDTRL : CALL
TDINT --> COMDATE : CALL

'Transfers -> account, common, audit
FTMNU --> FTINT : CALL
FTMNU --> FTWIR : CALL
FTMNU --> FTACH : CALL
FTMNU --> FTSTS : CALL
FTINT --> ACTBAL : CALL
FTINT --> AUDTRL : CALL
FTWIR --> ACTBAL : CALL
FTWIR --> ACTUPD : CALL
FTWIR --> AUDTRL : CALL
FTWIR --> COMHELP : CALL
FTACH --> ACTBAL : CALL
FTACH --> AUDTRL : CALL

'Batch -> all modules, files
BCHMNU --> BCHDAY : CALL
BCHMNU --> BCHMTH : CALL
BCHMNU --> BCHINT : CALL
BCHMNU --> BCHGLI : CALL
BCHMNU --> BCHODO : CALL
BCHMNU --> BCHFEE : CALL
BCHDAY --> BCHINT : CALL
BCHDAY --> BCHODO : CALL
BCHDAY --> BCHFEE : CALL
BCHDAY --> BCHGLI : CALL
BCHDAY --> RPTTXN : CALL
BCHDAY --> RPTBAL : CALL
BCHDAY --> AUDTRL : CALL
BCHDAY --> COMDATE : CALL

'Reports -> common
RPTMNU --> RPTBAL : CALL
RPTMNU --> RPTTXN : CALL
RPTMNU --> RPTDEL : CALL
RPTMNU --> RPTTLR : CALL
RPTMNU --> RPTGLB : CALL
RPTMNU --> RPTREG : CALL
RPTBAL --> COMDATE : CALL
RPTTXN --> COMDATE : CALL
RPTDEL --> COMDATE : CALL
RPTTLR --> COMDATE : CALL

'Audit -> common
AUDINQ --> COMDATE : CALL

'--- File I/O ---
CUSMNT --> FCUS : WRITE
CUSINQ --> FCUS : READ
CUSUPD --> FCUS : REWRITE
CUSSRH --> FCUS : START/READ
CUSSTS --> FCUS : REWRITE
CUSREL --> FAXR : READ/WRITE
CUSINQ --> FAXR : READ

ACTINQ --> FACT : READ
ACTOPN --> FACT : WRITE
ACTUPD --> FACT : REWRITE
ACTCLS --> FACT : REWRITE
ACTFRZ --> FACT : REWRITE
ACTBAL --> FACT : READ
ACTOPN --> FAXR : WRITE
ACTOPN --> FCHQ : WRITE

TLRDEP --> FACT : READ/REWRITE
TLRWTH --> FACT : READ/REWRITE
TLRTRF --> FACT : READ/REWRITE
TLRDEP --> FTRN : WRITE
TLRWTH --> FTRN : WRITE
TLRTRF --> FTRN : WRITE
TLRDEP --> FTLR : READ/REWRITE
TLRWTH --> FTLR : READ/REWRITE
TLRSGN --> FTLR : WRITE
TLRSMG --> FTLR : READ

LONAPL --> FLAP : WRITE
LONAPV --> FLAP : READ/REWRITE
LONDIS --> FLAP : READ/DELETE
LONDIS --> FLON : WRITE
LONPYM --> FLON : READ/REWRITE
LONINQ --> FLON : READ
LONDEL --> FLON : READ/REWRITE

SECSGN00 --> FUSR : READ/REWRITE
SECUSR00 --> FUSR : READ/WRITE
SECPWD00 --> FUSR : READ/REWRITE

BCHINT --> FACT : START/NEXT/REWRITE
BCHINT --> FGL : READ/REWRITE
BCHINT --> FTRN : WRITE
BCHGLI --> FACT : START/NEXT
BCHGLI --> FGL : READ/REWRITE
BCHGLI --> FTRN : START/NEXT
BCHODO --> FACT : START/NEXT/REWRITE
BCHODO --> FRAT : READ
BCHODO --> FTRN : WRITE
BCHFEE --> FACT : START/NEXT/REWRITE
BCHFEE --> FFEE : READ
BCHFEE --> FTRN : WRITE

RPTBAL --> FACT : START/NEXT
RPTTXN --> FTRN : START/NEXT
RPTDEL --> FLON : START/NEXT
RPTTLR --> FTLR : START/NEXT
RPTGLB --> FGL : START/NEXT

AUDTRL --> FAUD : WRITE
AUDINQ --> FAUD : START/NEXT

@enduml
